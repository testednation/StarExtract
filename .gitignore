# ---- build outputs ----
[Bb]in/
obj/
*.user
*.suo
*.cache
*.pdb
*.baml
*.g.cs
*.g.resources

# re-include the bundled third-party plugin suite at the repo root
!bin/

# stale in-place build artifacts (regenerated by dotnet build)
Easy7ZipModern*.exe
Easy7ZipModern*.pdb
StarExtract*.exe
StarExtract*.pdb
*.exe.config
App.g.cs
MainWindow.g.cs
*_MarkupCompile*
*FileListAbsolute.txt
*ResolveAssemblyReference.cache

# large build artifacts - distributed via GitHub Releases instead
installer/*.exe
installer/output/

# heavy archives kept locally only
*.zip
*.7z
7z2408-x64.exe

# native C++ edition - commit sources/build scripts/icon, ignore build outputs
native/*.obj
native/*.exe
native/*.manifest
native/*.res
native/res/version.rc
native/res/version.res
native/*.bak
native/x86/
native/7z.exe
native/7z.dll
native/compile_test.bat
native/test_compile.bat
native/test_link.c
native/test_minimal.cpp
native/syntax_check.bat
native/res/RCa07408

# local workspace metadata
.freebuff/

# runtime junk
*.log
*.tmp
Thumbs.db
desktop.ini
